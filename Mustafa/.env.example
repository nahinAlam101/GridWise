# Copy to .env and configure locally. Never commit the real .env.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# OPENAI_API_KEY is also accepted when LLM_API_KEY is empty.
LLM_JSON_MODE=json_schema
LLM_TIMEOUT_SECONDS=10
LLM_MAX_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=1800
LLM_REQUIRED=false
PORT=8000
POSTGRES_DB=gridwise
POSTGRES_USER=gridwise
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://gridwise:replace-with-a-local-password@db:5432/gridwise
